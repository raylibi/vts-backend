# ─────────────────────────────────────────────────────────────
#  VTS Backend — contoh konfigurasi environment
#  Salin file ini menjadi .env lalu isi dengan nilai kamu sendiri:
#    cp .env.example .env
#  JANGAN pernah commit file .env (sudah masuk .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────
# Dua cara koneksi — pilih salah satu:
#
# 1) Development lokal: isi DB_* di bawah dan biarkan DATABASE_URL kosong.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vts_logistik
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_postgres_kamu
#
# 2) Produksi / Postgres cloud (Railway, Neon, Supabase):
#    isi DATABASE_URL — jika ada, nilai DB_* di atas DIABAIKAN
#    dan koneksi otomatis memakai SSL.
# DATABASE_URL=postgresql://user:password@host:5432/database

# ── JWT ──────────────────────────────────────────────────────
# Wajib, minimal 16 karakter — server menolak start jika kosong/terlalu pendek.
# Buat secret acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_16_karakter
JWT_EXPIRES_IN=24h

# ── MQTT Broker ──────────────────────────────────────────────
# Lokal (Mosquitto, tanpa auth):
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
#
# Broker cloud dengan TLS (misal HiveMQ Cloud) — pakai skema mqtts:// port 8883:
# MQTT_BROKER_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=user_broker_kamu
# MQTT_PASSWORD=password_broker_kamu

# Topic yang di-subscribe backend ('+' = wildcard satu level, yaitu kode truk)
MQTT_TOPIC_TELEMETRY=vts/telemetry/+
MQTT_TOPIC_STATUS=vts/status/+

# ── CORS / Socket.io ─────────────────────────────────────────
# Origin frontend yang diizinkan. Beberapa origin dipisah koma.
CLIENT_ORIGIN=http://localhost:3000

# ── Retensi data (hari) ──────────────────────────────────────
# Hapus detail trip lama (telemetry, gps_log, rfid_event) lewat cron job.
# Trip yang pernah memicu alert disimpan lebih lama.
RETENTION_NORMAL_DAYS=30
RETENTION_ALERT_DAYS=90

# ─────────────────────────────────────────────────────────────
#  Khusus skrip di tools/ — tidak dipakai oleh server
#  Semua wajib diisi, tidak ada nilai default di dalam kode.
# ─────────────────────────────────────────────────────────────
# tools/uji_latensi_4g.js
# BACKEND_URL=http://localhost:3001
# ADMIN_EMAIL=admin@vts.com
# ADMIN_PASS=password_admin_kamu
# TRUCK_ID=TRUCK-001

# tools/setup_sim_trip.js
# VTS_API_URL=http://localhost:3001
# VTS_ADMIN_EMAIL=admin@vts.com
# VTS_ADMIN_PASS=password_admin_kamu

# tools/simulate_esp32_dummy.py  (juga membaca MQTT_* di atas)
# SIM_BROKER_HOST=localhost
# SIM_BROKER_PORT=1883

# Password akun hasil seeding (seeds/seed_trip.js, seeds/seed_esp32_test.js)
# SEED_ADMIN_PASSWORD=password_admin_untuk_seed
# SEED_DRIVER_PASSWORD=password_driver_untuk_seed
